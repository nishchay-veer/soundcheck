  "cards": [
    {
      "dot": "amber",
      "title": "Single run per soundcheck",
      "items": [
        "The claim transaction refuses a second concurrent run",
        "A run silent for 20 minutes counts as dead and can be reclaimed",
        "If the job crashes while running, the workflow marks it failed"
      ]
    },
    {
      "dot": "rose",
      "title": "Plain failures",
      "items": [
        "private_video, video_unavailable, too_short, too_long, unsupported_type",
        "no_model when neither measured audience has a model; unreadable after Gemini's retry",
        "internal is rethrown so Cloud Run retries the task once"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the result holds",
      "items": [
        "Per audience: 10 to 90% curve bands, average view and share of the cut",
        "Better than N% of the newest 20 videos, by average view",
        "Edits with their own effect; inputs/current lets the simulate route replay them"
      ]
    }
