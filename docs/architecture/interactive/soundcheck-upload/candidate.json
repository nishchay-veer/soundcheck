  "cards": [
    {
      "dot": "cyan",
      "title": "Bytes skip the web app",
      "items": [
        "The server fixes the object name, type and exact size; ifGenerationMatch=0 forbids overwrite",
        "The browser PUTs 8 MiB chunks straight to Cloud Storage",
        "ffprobe and Gemini read the object in place; nothing downloads 2 GB"
      ]
    },
    {
      "dot": "amber",
      "title": "What starts the job",
      "items": [
        "Cloud Storage fires object.finalized only once the last chunk lands",
        "Eventarc fires for every object in the bucket, including soundcheck archives",
        "The workflow ignores names other than {channel}/{32 hex}/source.ext"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals before any work",
      "items": [
        "404 for someone else's channel, 409 before the first build has published",
        "415 for other types, 413 over 2 GB, 503 without the workflow or in fixtures mode",
        "An expired session (404 or 410) asks the creator to start again"
      ]
    }
  ]
