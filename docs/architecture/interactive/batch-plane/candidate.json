  "cards": [
    {
      "dot": "cyan",
      "title": "Who starts what",
      "items": [
        "soundcheck-web starts channel_build on connect or Build now, and soundcheck for a YouTube link",
        "Eventarc starts soundcheck when an upload finishes; other objects are ignored by name",
        "Cloud Scheduler starts weekly_refresh, which starts channel_build per ready channel"
      ]
    },
    {
      "dot": "amber",
      "title": "Retries are layered",
      "items": [
        "Each external call: withRetry, at most 6 attempts, on 429, 5xx, UNAVAILABLE, RESOURCE_EXHAUSTED",
        "Each Cloud Run task: --max-retries 1 or 2 per job",
        "Each build stage: 3 attempts in run_stage, 30 s then 60 s apart; then build.state failed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Language split",
      "items": [
        "TypeScript computes every feature and writes training_bins",
        "Python reads them, fits, and writes JSON artifacts validated against the zod-exported schema",
        "Publish and soundcheck read the artifacts back in TypeScript"
      ]
    }
  ]
