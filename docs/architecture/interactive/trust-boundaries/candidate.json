  "cards": [
    {
      "dot": "rose",
      "title": "Identity, not network",
      "items": [
        "No VPC or ingress restriction: every crossing is an IAM grant on a service account",
        "soundcheck-web is public; Google sign-in and requireChannel are the gates",
        "Firestore rules deny every client; only server SDKs read or write"
      ]
    },
    {
      "dot": "amber",
      "title": "Broad rights on sa-web",
      "items": [
        "objectAdmin on all three buckets and dataEditor on the dataset, for channel deletion",
        "A compromised web container could read or change any channel's data",
        "iam.serviceAccountTokenCreator on itself is granted for signed URLs the code no longer uses"
      ]
    },
    {
      "dot": "emerald",
      "title": "Token protection",
      "items": [
        "Refresh tokens are KMS-encrypted with the owner's user ID as additional authenticated data",
        "sa-pipeline can only decrypt; tokens never reach the browser or the JWT",
        "invalid_grant marks the channel reauth_required and stops the job"
      ]
    }
  ]
