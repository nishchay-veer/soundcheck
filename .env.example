# Copy to .env.local (web) or export in the shell (pipeline). Parsed by packages/core/src/env.ts.

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=us-central1
BQ_DATASET=soundcheck
BQ_LOCATION=US
GCS_RAW_BUCKET=
GCS_UPLOADS_BUCKET=
GCS_MEDIA_BUCKET=
FIRESTORE_DATABASE=(default)
KMS_KEY_NAME=

# Auth.js
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_URL=

# Gemini and Imagen (model IDs always come from here, never from code)
GEMINI_LOCATION=global
GEMINI_MODEL=
GEMINI_FLASH_MODEL=
IMAGEN_MODEL=

# Cloud Workflows
WORKFLOW_CHANNEL_BUILD=
WORKFLOW_SOUNDCHECK=

# Modeling thresholds
MIN_VIEWS=500
MIN_TRAIN_VIDEOS=30

# Demo
DEMO_CHANNEL_ID=

# Client-safe
NEXT_PUBLIC_USE_FIXTURES=false
