{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": ["src/**/*.py", "tests/**/*.py", "schemas/**", "pyproject.toml", "uv.lock"]
    },
    "typecheck": {
      "inputs": ["src/**/*.py", "tests/**/*.py", "schemas/**", "pyproject.toml", "uv.lock"]
    },
    "test": {
      "inputs": ["src/**/*.py", "tests/**/*.py", "schemas/**", "pyproject.toml", "uv.lock"]
    }
  }
}
