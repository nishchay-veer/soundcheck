{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[\\w-]+$"
    },
    "channel_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^UC[\\w-]{22}$"
        },
        {
          "type": "string",
          "const": "pooled"
        }
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "all",
        "subscribed",
        "unsubscribed"
      ]
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "feature_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "fitted",
        "not_converged",
        "no_data",
        "failed"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_uri": {
      "anyOf": [
        {
          "type": "string",
          "format": "starts_with",
          "pattern": "^gs:\\/\\/.*"
        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "run_id",
    "channel_id",
    "audience",
    "model_version",
    "feature_version",
    "status",
    "started_at",
    "finished_at",
    "artifact_uri",
    "details"
  ],
  "additionalProperties": false
}
