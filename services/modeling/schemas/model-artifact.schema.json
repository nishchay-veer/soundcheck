{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[\\w-]+$"
    },
    "channelId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^UC[\\w-]{22}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "all",
        "subscribed",
        "unsubscribed"
      ]
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "featureVersion": {
      "type": "string",
      "minLength": 1
    },
    "extractionVersion": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "featureNames": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "droppedFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unpenalized": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mean": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "sd": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "alpha": {
      "type": "number"
    },
    "beta": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "cov": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "lambda": {
      "type": "number",
      "minimum": 0
    },
    "priorRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "trainChannelIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^UC[\\w-]{22}$"
      }
    },
    "trainVideoIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "channelContext": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "medianTargetLevel": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "mixMean": {
              "type": "object",
              "properties": {
                "search": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "suggested": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "browse": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "search",
                "suggested",
                "browse"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "medianTargetLevel",
            "mixMean"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "usable": {
      "type": "boolean"
    },
    "unusableReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "videos": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trainLoss": {
          "type": "number"
        },
        "cv": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lambda": {
                "type": "number",
                "minimum": 0
              },
              "loss": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "lambda",
              "loss"
            ],
            "additionalProperties": false
          }
        },
        "folds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "converged": {
          "type": "boolean"
        },
        "gradientNorm": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "rows",
        "videos",
        "trainLoss",
        "cv",
        "folds",
        "iterations",
        "converged",
        "gradientNorm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runId",
    "channelId",
    "audience",
    "modelVersion",
    "featureVersion",
    "extractionVersion",
    "createdAt",
    "featureNames",
    "droppedFeatures",
    "unpenalized",
    "mean",
    "sd",
    "alpha",
    "beta",
    "cov",
    "lambda",
    "priorRef",
    "trainChannelIds",
    "trainVideoIds",
    "channelContext",
    "usable",
    "unusableReasons",
    "metrics"
  ],
  "additionalProperties": false
}
