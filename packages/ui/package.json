{
  "name": "@soundcheck/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@soundcheck/eslint-config": "workspace:*",
    "@soundcheck/typescript-config": "workspace:*",
    "@soundcheck/vitest-config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "eslint": "10.11.0",
    "react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
