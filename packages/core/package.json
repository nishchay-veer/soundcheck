{
  "name": "@soundcheck/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./schemas": "./src/schemas/index.ts",
    "./features": "./src/features/index.ts",
    "./model": "./src/model/index.ts",
    "./data": "./src/data/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.1.0",
    "@google-cloud/firestore": "9.3.0",
    "@google-cloud/kms": "6.2.1",
    "@google-cloud/secret-manager": "7.1.1",
    "@google-cloud/storage": "8.2.0",
    "@google-cloud/workflows": "6.1.1",
    "p-limit": "7.3.3",
    "p-retry": "8.0.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@soundcheck/eslint-config": "workspace:*",
    "@soundcheck/typescript-config": "workspace:*",
    "@soundcheck/vitest-config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
